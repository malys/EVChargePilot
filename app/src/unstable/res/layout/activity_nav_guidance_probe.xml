<?xml version="1.0" encoding="utf-8"?>
<!-- Impeccable direction contract
     THESIS: one parked-only action proves whether the head unit reports a route at all.
     OWN-WORLD: EVSuite instrument surfaces, monospace trace, one rail, no decoration or motion.
     STORY: bind the adapter, arm the listener while parked, drive, then read the trace parked.
     FIRST VIEWPORT: the trace fills the field; state, hint and actions stay in the rail.
     FORM: inherited asymmetric instrument binnacle; seed key chargepilot-evidence-rail.
     FINISH: unreviewed and undocumented is unfinished; CP-040 ends with a written decision.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_probe_title"
            android:textAppearance="@style/Text.EV.Title" />

        <TextView
            android:id="@+id/probeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="end"
            android:text="@string/nav_probe_idle"
            android:textAppearance="@style/Text.EV.Body" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="@dimen/spacing_md">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/probeTrace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/nav_probe_no_data"
                    android:textAppearance="@style/Text.EV.Body" />
            </HorizontalScrollView>
        </ScrollView>

        <LinearLayout
            android:layout_width="@dimen/chargepilot_rail_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/probeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/nav_probe_hint_ready"
                android:textAppearance="@style/Text.EV.Secondary" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/probeAction"
                style="@style/Widget.EVChargePilot.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/nav_probe_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveAction"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/nav_probe_save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
