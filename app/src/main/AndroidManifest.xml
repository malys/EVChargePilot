<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read-only vehicle data. EVChargePilot declares no install or overlay capability and
         writes no vehicle property. Network and location it now declares; see the CP-043
         block below for what they may and may not be used for.

         Two of the permissions below read like write access and are not:
         CONTROL_CAR_CLIMATE is what AAOS requires to *read* HVAC state — the platform
         defines no read-only HVAC permission — and CAR_VENDOR_EXTENSION is what the
         vendor property space requires to be read at all. The app calls no setter: every
         vehicle access goes through EVHardware's telemetry reader, which exposes getters
         only, and VehicleWriteGate has nothing to gate here. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <!-- Trip recording keeps sampling while the driver looks at another app, which on API 26+
         means a foreground service. Both permissions are install-time and neither reaches the
         vehicle: FOREGROUND_SERVICE allows the service at all, and FOREGROUND_SERVICE_SPECIAL_USE
         backs the one type that fits. The platform's catalogue has no entry for recording a
         vehicle's own energy telemetry to local storage — `dataSync` describes transferring data
         to somewhere else, which this app has no permission to do and no code for, and from
         Android 15 it carries a daily runtime cap a long drive would hit. POST_NOTIFICATIONS is
         deliberately absent: the target head unit runs API 28, where it does not exist, and a
         permission this app never asks for on a screen the driver reaches is a permission it
         does not have. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Route planning. Reviewed and accepted by the owner under CP-043 on 2026-09-04; the
         reasoning, the engine choice and the privacy boundary are in
         analysis/CP-043_network_and_location.md, and these two lines are meaningless without
         it.

         INTERNET carries route requests to the routing host the driver configures, and
         nothing else. No trip, evidence capture, diagnostic bundle, charge, range, speed or
         identifier crosses a network by any path this app controls. https and a host
         allowlist are enforced on the initial URL and on every redirect hop; no API key ships
         inside the APK.

         ACCESS_FINE_LOCATION supplies a route origin and an altitude. Coarse location cannot:
         it snaps an origin to the wrong side of a junction and carries no usable altitude.
         ACCESS_COARSE_LOCATION is declared beside it because Android 12+ refuses a fine-only
         request — the driver may grant approximate location instead, and the app must treat
         that as a refusal of what it asked for rather than as a usable origin.
         The grant is requested from a parked screen the driver reaches deliberately, never at
         start and never from a service, and refusal is a supported state — the arrival
         forecast keeps working from the head unit's own guidance, which never needed a
         position.

         Beware the group on this platform: CAR_SPEED is in permission group LOCATION, and on
         API 28 the system grants a requested permission without a prompt when another in the
         same group is already held. A driver who granted speed may therefore never see a
         location dialog. Confirm on the vehicle before treating the prompt as the consent.

         FOREGROUND_SERVICE_LOCATION is deliberately absent: no service reads a position, and
         the foreground type mask stays derived from permissions held at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".ChargePilotApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:taskAffinity=""
        android:supportsRtl="true"
        android:theme="@style/Theme.EVChargePilot">

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TripHistoryActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".TripDeleteConfirmationActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".TripExportActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SpeedWhatIfActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ArrivalForecastActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".EnergyBreakdownActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".TripRecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records the vehicle's own energy telemetry to app-private storage for the duration of a trip the driver started. No data leaves the car." />
        </service>
    </application>

</manifest>
