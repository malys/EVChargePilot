<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EV.Readout" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>

    <style name="Text.EV.ReadoutLabel" parent="Text.EV.SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Text.EV.ReadoutValue" parent="Text.EV.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Text.EV.TripValue" parent="Text.EV.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Widget.EV.ClimateReadout" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <style name="Text.EV.ClimateValue" parent="Text.EV.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Widget.EVChargePilot.Button" parent="Widget.EV.Button">
        <item name="android:textColor">@color/ev_button_text</item>
        <item name="backgroundTint">@color/ev_button_fill</item>
    </style>

    <style name="Widget.EVChargePilot.Button.Danger" parent="Widget.EV.Button">
        <item name="android:textColor">@color/ev_on_accent</item>
        <item name="backgroundTint">@color/ev_error</item>
    </style>

    <!-- Top-level destinations use one connected control. Checked state is both a
         position in the strip and a filled surface, so colour never carries it alone. -->
    <style name="Widget.EVChargePilot.NavTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_nav_foreground</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="backgroundTint">@color/primary_nav_background</item>
        <item name="strokeColor">@color/ev_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ev_corner</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- CP-083. A figure that fills its tile: the tile's weight decides the room, the text
         sizes itself into it, one line, never clipped. -->
    <style name="Text.EVChargePilot.Hero" parent="Text.EV.Display">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/chargepilot_text_hero_floor</item>
        <item name="autoSizeMaxTextSize">@dimen/chargepilot_text_hero</item>
    </style>

    <style name="Text.EVChargePilot.HeroSecondary" parent="Text.EVChargePilot.Hero">
        <item name="autoSizeMaxTextSize">@dimen/chargepilot_text_hero_secondary</item>
    </style>

    <!-- An action named by its icon, square at the touch target. The name is still there for
         anyone who asks: contentDescription for TalkBack, tooltipText for a long press. Used
         only for actions whose glyph is unambiguous in context — export, delete, history. -->
    <style name="Widget.EVChargePilot.IconButton" parent="Widget.EV.Button.Outlined">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconTint">@color/ev_accent</item>
    </style>

    <!-- The page's primary action as an icon: filled, so it still reads as the one to press. -->
    <style name="Widget.EVChargePilot.IconButton.Filled" parent="Widget.EVChargePilot.Button">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconTint">@color/ev_button_text</item>
    </style>

    <!-- An outlined action that also carries its icon: the one the eye should find first. -->
    <style name="Widget.EVChargePilot.Button.OutlinedIcon" parent="Widget.EV.Button.Outlined">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_sm</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/ev_accent</item>
    </style>
</resources>
