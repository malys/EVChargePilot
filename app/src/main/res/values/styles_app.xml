<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.EV.Readout" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>

    <style name="Text.EV.ReadoutLabel" parent="Text.EV.SectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Text.EV.ReadoutValue" parent="Text.EV.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Text.EV.TripValue" parent="Text.EV.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Widget.EV.ClimateReadout" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <style name="Text.EV.ClimateValue" parent="Text.EV.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:text">@string/value_unavailable</item>
    </style>

    <style name="Widget.EVChargePilot.Button" parent="Widget.EV.Button">
        <item name="android:textColor">@color/ev_button_text</item>
        <item name="backgroundTint">@color/ev_button_fill</item>
    </style>

    <style name="Widget.EVChargePilot.Button.Danger" parent="Widget.EV.Button">
        <item name="android:textColor">@color/ev_on_accent</item>
        <item name="backgroundTint">@color/ev_error</item>
    </style>

    <!-- Top-level destinations use one connected control. Checked state is both a
         position in the strip and a filled surface, so colour never carries it alone. -->
    <style name="Widget.EVChargePilot.NavTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_nav_foreground</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="backgroundTint">@color/primary_nav_background</item>
        <item name="strokeColor">@color/ev_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ev_corner</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Text.EVChargePilot.Soc" parent="Text.EV.Display">
        <item name="android:textSize">@dimen/chargepilot_text_soc</item>
    </style>
</resources>
