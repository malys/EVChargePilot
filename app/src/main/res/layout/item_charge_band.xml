<?xml version="1.0" encoding="utf-8"?>
<!-- CP-085. One band of the charge curve: the levels, a bar as long as the mean pack power against
     the strongest band, and the figure. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xs"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/bandRange"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textAppearance="@style/Text.EV.Secondary" />

    <com.evsuite.chargepilot.BarGaugeView
        android:id="@+id/bandBar"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:layout_weight="1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/bandPower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textAppearance="@style/Text.EV.Secondary" />
</LinearLayout>
