<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: everything this app is configured with, side by side, in one viewport, saved by one button.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, no shadow or motion.
  STORY: the vehicle's figures, the keys, and the app's own preferences as three cards; the file
         and the Save are page actions in the bar.
  FIRST VIEWPORT: all of it, with the keyboard down. The scroll exists only for when it is up.
  FORM: the second version put two columns over a pinned Save bar and still scrolled: the eco and
        language cards sat below the fold. Save joined Import and Export in the top bar, the six
        vehicle figures became a 2 × 3 grid, and the preferences took the third column.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chargepilot_bar_height"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <include
            layout="@layout/view_primary_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- The USB file and the Save are the whole page's, not one card's, so they sit in the
             bar where Trips and Battery keep their page actions. Save is the filled one; all three
             are icons, as on Trips, so the tabs keep the room. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsImportAction"
            style="@style/Widget.EVChargePilot.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="match_parent"
            android:contentDescription="@string/settings_action_import"
            android:tooltipText="@string/settings_action_import"
            app:icon="@drawable/ic_action_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsExportAction"
            style="@style/Widget.EVChargePilot.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/settings_action_export"
            android:tooltipText="@string/settings_action_export"
            app:icon="@drawable/ic_action_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsSaveAction"
            style="@style/Widget.EVChargePilot.IconButton.Filled"
            android:layout_width="@dimen/touch_target"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/routing_action_save"
            android:tooltipText="@string/routing_action_save"
            app:icon="@drawable/ic_action_save" />
    </LinearLayout>

    <!-- Kept only for the soft keyboard, which takes the bottom half of the panel. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/chargepilot_bar_gap"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <!-- One line for the whole page: parked or not, and what the last action did. -->
            <TextView
                android:id="@+id/settingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:maxLines="2"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:textAppearance="@style/Text.EV.Secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehicle_title"
                        android:textAppearance="@style/Text.EV.Title" />

                    <!-- Whose figures these are, and — when they are not the driver's — what the
                         defaults describe. Empty means the documented default, which is what
                         `VehicleSettings.parse` has always done with a cleared box, so each
                         field's helper names its default and clearing the boxes is the reset. -->
                    <TextView
                        android:id="@+id/vehicleWhose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/Text.EV.Secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/capacityLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_capacity"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/capacityInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/healthLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_health"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/healthInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/minPowerLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_min_power"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/minPowerInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/reserveLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_reserve"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/reserveInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/departureLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_departure"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/departureInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/referenceLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:hint="@string/vehicle_hint_reference"
                            app:helperTextTextAppearance="@style/Text.EV.Secondary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/referenceInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1.25"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/routing_title"
                        android:textAppearance="@style/Text.EV.Title" />

                    <!-- The one thing the fields cannot show: a stored key is never displayed
                         back, so whether there is one has to be said. -->
                    <TextView
                        android:id="@+id/routingState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/Text.EV.Secondary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/routingKeyLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="@string/routing_hint_key"
                        app:endIconContentDescription="@string/routing_desc_toggle_key"
                        app:endIconMinSize="@dimen/touch_target"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/routing_helper_key"
                        app:helperTextTextAppearance="@style/Text.EV.Secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/routingKeyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:saveEnabled="false"
                            android:singleLine="true"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/chargerKeyLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="@string/routing_hint_charger_key"
                        app:endIconContentDescription="@string/routing_desc_toggle_key"
                        app:endIconMinSize="@dimen/touch_target"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/routing_helper_charger_key"
                        app:helperTextTextAppearance="@style/Text.EV.Secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/chargerKeyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:saveEnabled="false"
                            android:singleLine="true"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/routingBaseUrlLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="@string/routing_hint_base_url"
                        app:helperText="@string/routing_helper_base_url"
                        app:helperTextTextAppearance="@style/Text.EV.Secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/routingBaseUrlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- The page's one destructive action, and the only one that cannot be an
                         empty field: a stored key is never shown, so clearing the box cannot
                         mean "remove the key I cannot see". -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/routingClearAction"
                        style="@style/Widget.EVChargePilot.IconButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:contentDescription="@string/routing_action_clear"
                        android:tooltipText="@string/routing_action_clear"
                        app:icon="@drawable/ic_action_delete"
                        app:iconTint="@color/ev_error" />
                </LinearLayout>

                <!-- CP-074. The app's own preferences. Switches and language apply on the tap,
                     with no Save: a coach the driver wants silenced is silenced by the tap. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eco_settings_title"
                        android:textAppearance="@style/Text.EV.Title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ecoAdviceSwitch"
                        style="@style/Widget.EV.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eco_settings_advice" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ecoVoiceSwitch"
                        style="@style/Widget.EV.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eco_settings_voice" />

                    <!-- The voice test's outcome, so a refusal is read rather than guessed. -->
                    <TextView
                        android:id="@+id/ecoVoiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/Text.EV.Secondary"
                        android:visibility="gone" />

                    <!-- CP-087. Battery advice is always kept in its history; this only decides
                         whether it also reaches the driver as a notification when parked. -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/adviceNotifySwitch"
                        style="@style/Widget.EV.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/advice_settings_notify" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/eco_settings_note"
                        android:textAppearance="@style/Text.EV.Secondary" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- The same control as EVTasker's: one button naming the language in use,
                         opening the list of the five the suite speaks. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/language_settings_title"
                        android:textAppearance="@style/Text.EV.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/language_settings_note"
                        android:textAppearance="@style/Text.EV.Secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageAction"
                        style="@style/Widget.EVChargePilot.Button.OutlinedIcon"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:icon="@drawable/ic_action_language" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
