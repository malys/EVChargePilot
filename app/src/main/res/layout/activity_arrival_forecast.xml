<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/arrival_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:id="@+id/arrivalStatus"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/Text.EV.Body"
                android:accessibilityLiveRegion="polite" />

            <TextView
                android:id="@+id/arrivalValue"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Title" />

            <TextView
                android:id="@+id/arrivalDetail"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
