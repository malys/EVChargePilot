<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: choosing where you are going is a screen of its own, not a strip under a plan.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, no shadow or motion.
  STORY: type it on the left and pick it, or take one you already saved on the right.
  FIRST VIEWPORT: both columns whole; the panel is 1920 wide and the list used 200dp of it.
  FORM: two columns, each scrolling on its own, so neither list pushes the other off screen.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/destination_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoritesImportAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="260dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/charge_stop_favorites_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoritesExportAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="260dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/charge_stop_favorites_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_back" />
    </LinearLayout>

    <TextView
        android:id="@+id/destinationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:textAppearance="@style/Text.EV.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <!-- Searched, on the left: what the driver came here to type. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destinationLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/charge_stop_hint_destination"
                    app:helperText="@string/charge_stop_helper_destination"
                    app:helperTextTextAppearance="@style/Text.EV.Secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destinationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textSize="@dimen/text_body" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchAction"
                    style="@style/Widget.EVChargePilot.Button"
                    android:layout_width="240dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:text="@string/charge_stop_action_search" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/destinationResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Saved, on the right: EVChargePilot's own list — MG4 Navigator publishes no provider
             and no intent for its own, so there is nothing to sync with (CP-056). It travels on
             the USB stick inside the one configuration file, next to the keys. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_lg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charge_stop_favorites_title"
                android:textAppearance="@style/Text.EV.Body" />

            <TextView
                android:id="@+id/destinationFavoritesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/Text.EV.Secondary" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/destinationFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
