<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: one sentence a driver acts on — charge in N km, or arrive with this much left.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, no shadow or motion.
  STORY: where are you going, which of these did you mean, then the stop and why it is uncertain.
  FIRST VIEWPORT: fixed destination strip; the plan owns the centre once it exists.
  FORM: parked planning sheet opened by choosing a destination; Back returns to the dashboard.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/charge_stop_title"
            android:textAppearance="@style/Text.EV.Title" />

        <!-- CP-056, moved into the top bar on 2026-09-11. The action that ends this screen sat
             in a bar of its own below the scroller, shown only once a route came back. Every
             path that returns before a route — no routing key, no fine grant, no fix — left the
             screen with one enabled control, the chooser, whose label is the destination just
             picked: the driver reads it as the way to go there, taps it, and the chooser
             reopens. That is the loop reported from the car twice. It now lives in the bar that
             is always on screen, carries no android:visibility of its own, and is disabled
             rather than hidden when there is nowhere to send.

             Its caveat rides below, in the scroller, and never becomes the button's own label,
             because a driver reads a button as a promise and this one cannot make it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigateAction"
            style="@style/Widget.EVChargePilot.Button"
            android:layout_width="360dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/charge_stop_navigate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:id="@+id/chargeStopStatus"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/Text.EV.Body" />

            <!-- CP-044. Choosing where you are going is its own screen: it needs a keyboard,
                 two lists and the whole panel, and it used to be a strip below this line. The
                 button carries the chosen place, so the plan below always says what it is about. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chooseDestinationAction"
                style="@style/Widget.EVChargePilot.Button"
                android:layout_width="1400dp"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/charge_stop_action_destination" />

            <TextView
                android:id="@+id/navigateNote"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="@style/Text.EV.Secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chargeStopPlan"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Title"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chargeStopDetail"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chargerPlace"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone" />

            <!-- Never merged into the line above: a record's age is what stops it reading as a
                 promise, and a promise is what sends someone to a charger that is not there. -->
            <TextView
                android:id="@+id/chargerSource"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/Text.EV.Secondary"
                android:visibility="gone" />

            <!-- CP-049. Its own card, under the plan rather than inside it: what the driver
                 would gain by driving differently is not what the plan says will happen. -->
            <TextView
                android:id="@+id/routeWhatIf"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone" />

            <!-- CP-057. The comparison the driver was doing in their head across the cards
                 above: same destination, three ways to reach it, one of which they pick. -->
            <TextView
                android:id="@+id/routeChoices"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chargeStopAttribution"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textAppearance="@style/Text.EV.Secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
