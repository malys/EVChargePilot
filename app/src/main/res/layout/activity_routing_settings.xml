<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: one key, entered or imported, that never leaves the car and is never displayed back.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, no shadow or motion.
  STORY: say whether routing is configured, offer the two ways to configure it, then the boundary.
  FIRST VIEWPORT: fixed top context and Back action; the status owns the top of the sheet.
  FORM: parked configuration sheet, the ABRP uploader's config file in EVChargePilot's clothes.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/routing_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:id="@+id/routingStatus"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/routingKeyLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/routing_hint_key"
                app:endIconContentDescription="@string/routing_desc_toggle_key"
                app:endIconMinSize="@dimen/touch_target"
                app:endIconMode="password_toggle"
                app:helperText="@string/routing_helper_key"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/routingKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/chargerKeyLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/routing_hint_charger_key"
                app:endIconContentDescription="@string/routing_desc_toggle_key"
                app:endIconMinSize="@dimen/touch_target"
                app:endIconMode="password_toggle"
                app:helperText="@string/routing_helper_charger_key"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chargerKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/routingBaseUrlLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/routing_hint_base_url"
                app:helperText="@string/routing_helper_base_url"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/routingBaseUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routingSaveAction"
                    style="@style/Widget.EVChargePilot.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/routing_action_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routingImportAction"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/routing_action_import" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routingExportAction"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/routing_action_export" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routingClearAction"
                    style="@style/Widget.EVChargePilot.Button.Danger"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/routing_action_clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/routingPrivacy"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:text="@string/routing_privacy"
                android:textAppearance="@style/Text.EV.Secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
