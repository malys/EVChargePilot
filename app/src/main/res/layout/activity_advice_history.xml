<?xml version="1.0" encoding="utf-8"?>
<!-- CP-087. Every advice the app gave, newest first, as it was said. One pane: the text is the
     content, and a line of advice reads better wide than squeezed beside a second column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chargepilot_bar_height"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/advice_history_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_back" />
    </LinearLayout>

    <ScrollView
        style="@style/Widget.EV.Readout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/chargepilot_bar_gap"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.EV.ReadoutLabel"
                android:text="@string/advice_history_list" />

            <LinearLayout
                android:id="@+id/adviceRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/adviceEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advice_history_empty"
                android:textAppearance="@style/Text.EV.Secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
