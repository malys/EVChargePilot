<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed title width keeps every destination under the same point after a swipe. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/touch_target"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:layout_width="@dimen/chargepilot_primary_title_width"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/Text.EV.Title" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/primaryNavigation"
        android:layout_width="1000dp"
        android:layout_height="match_parent"
        app:selectionRequired="true"
        app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navEnergy"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_energy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navArrival"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_arrival" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navTrips"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_trips" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navDiagnostics"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_diagnostics" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navSettings"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_settings" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
