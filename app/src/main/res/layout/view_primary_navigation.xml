<?xml version="1.0" encoding="utf-8"?>
<!-- Visible fallback for horizontal swipe navigation; selected page has fill plus label. -->
<com.google.android.material.button.MaterialButtonToggleGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/primaryNavigation"
    android:layout_width="1000dp"
    android:layout_height="@dimen/touch_target"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navEnergy"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_energy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navArrival"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_arrival" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navTrips"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_trips" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navDiagnostics"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_diagnostics" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navSettings"
        style="@style/Widget.EVChargePilot.NavTab"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:text="@string/tab_settings" />
</com.google.android.material.button.MaterialButtonToggleGroup>
