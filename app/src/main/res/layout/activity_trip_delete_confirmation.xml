<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:id="@+id/confirmationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmAction"
            style="@style/Widget.EVChargePilot.Button.Danger"
            android:layout_width="220dp"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/action_delete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/confirmationMessage"
            android:layout_width="900dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/Text.EV.Title" />

        <TextView
            android:id="@+id/gateStatus"
            android:layout_width="900dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:textAppearance="@style/Text.EV.Body" />
    </LinearLayout>
</LinearLayout>
