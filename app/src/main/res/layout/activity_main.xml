<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · native macrostructure: instrument + rail + destination strip · tone: austere · anchor: cyan
     Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V5
     Impeccable direction contract
     THESIS: the driving companion; only figures that change a decision at speed, and large.
     OWN-WORLD: EVSuite tonal surfaces, one outline, one radius, no shadow or decoration.
     STORY: charge now, charge on arrival, what the drive costs; then the verdict and the advice.
     FIRST VIEWPORT: three hero figures across the panel; everything else is on the Details page.
     FORM: CP-083 hero row over a verdict row; seed key chargepilot-companion.
     FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chargepilot_bar_height"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <include
            layout="@layout/view_primary_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Full-height target despite secondary typography. Wide as its own text: the
             version it shows grows with the build number, and 140dp wrapped it onto two
             lines inside a 72dp bar. -->
        <TextView
            android:id="@+id/aboutAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_lg"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/about_action"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAppearance="@style/Text.EV.Secondary"
            android:textColor="@color/ev_accent" />

    </LinearLayout>

    <!-- CP-083. Everything here is read at speed. The climate, the trip totals and the trip
         controls moved to the Details page; speed is on the cluster and the manufacturer's
         range repeats the adaptive one. Rows share the height by weight and the figures size
         themselves into it: the car's usable height is not the emulator's (CP-076). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/chargepilot_bar_gap"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@drawable/bg_card"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView style="@style/Text.EV.ReadoutLabel" android:text="@string/label_battery" />
                <TextView android:id="@+id/socValue" style="@style/Text.EVChargePilot.Hero" android:text="@string/value_soc_unavailable" />
                <!-- One line with one job: where this number comes from, or in red that it
                     comes from nowhere. -->
                <TextView
                    android:id="@+id/dataStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/soc_vehicle_reported"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>

            <!-- The charge on arrival while the car's navigation guides a route, the adaptive
                 range otherwise: the one figure that answers "will I make it". -->
            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView android:id="@+id/reachLabel" style="@style/Text.EV.ReadoutLabel" android:text="@string/label_adaptive_range" />
                <TextView android:id="@+id/reachValue" style="@style/Text.EVChargePilot.Hero" />
                <TextView
                    android:id="@+id/reachDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView style="@style/Text.EV.ReadoutLabel" android:text="@string/label_instant_consumption" />
                <TextView android:id="@+id/instantConsumptionValue" style="@style/Text.EVChargePilot.Hero" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- CP-074. The verdict: the word carries the meaning, the delta sits under it. -->
            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView style="@style/Text.EV.ReadoutLabel" android:text="@string/label_eco" />
                <TextView android:id="@+id/ecoValue" style="@style/Text.EVChargePilot.HeroSecondary" />
                <TextView
                    android:id="@+id/ecoDelta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Body" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView style="@style/Text.EV.ReadoutLabel" android:text="@string/label_trip_average_consumption" />
                <TextView android:id="@+id/tripConsumptionValue" style="@style/Text.EVChargePilot.HeroSecondary" />
            </LinearLayout>

            <!-- The bar is the reading at a glance; the figure and its state say it in words,
                 so neither the direction nor the value rests on the bar alone. -->
            <LinearLayout style="@style/Widget.EV.Readout" android:layout_height="match_parent" android:layout_weight="1" android:padding="@dimen/spacing_md">
                <TextView style="@style/Text.EV.ReadoutLabel" android:text="@string/label_power" />
                <TextView android:id="@+id/powerValue" style="@style/Text.EVChargePilot.HeroSecondary" android:text="@string/value_power_unavailable" />
                <com.evsuite.chargepilot.PowerFlowView
                    android:id="@+id/powerFlow"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/powerState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/power_state_waiting"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- CP-058. The whole plan companion, on one line: a TextView rather than a banner, a
             dialog or a sound, because none of those can be ignored. -->
        <TextView
            android:id="@+id/driftLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:padding="@dimen/spacing_md"
            android:textAppearance="@style/Text.EV.Title"
            android:visibility="gone" />

        <!-- CP-074. The advice, only when the driver asked for it; gone rather than stale when
             there is nothing measurable to say. The voice says the same line (CP-083: from the
             recorder, so it carries on behind the map). -->
        <TextView
            android:id="@+id/ecoAdviceLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:padding="@dimen/spacing_md"
            android:textAppearance="@style/Text.EV.Title"
            android:visibility="gone" />

        <!-- CP-084. In place of the advice when no lever applies: the harsh-acceleration share
             as a bar, the mark where the steadiness advice starts, and a word that says it. -->
        <LinearLayout
            android:id="@+id/ecoGauge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:visibility="gone">

            <TextView
                android:id="@+id/ecoGaugeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textAppearance="@style/Text.EV.Title" />

            <com.evsuite.chargepilot.BarGaugeView
                android:id="@+id/ecoGaugeBar"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
