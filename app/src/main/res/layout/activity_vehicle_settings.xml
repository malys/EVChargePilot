<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: four numbers about this car and this driver, declared instead of assumed.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, no shadow or motion.
  STORY: say what the app is using now, offer the four figures, then name the assumption behind the defaults.
  FIRST VIEWPORT: fixed top context and Back action; what is in force owns the top of the sheet.
  FORM: parked configuration sheet, the routing sheet's clothes with numbers instead of a key.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/vehicle_title"
            android:textAppearance="@style/Text.EV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backAction"
            style="@style/Widget.EV.Button.Outlined"
            android:layout_width="180dp"
            android:layout_height="@dimen/touch_target"
            android:text="@string/action_back" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:id="@+id/vehicleStatus"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="@dimen/spacing_lg"
                android:textAppearance="@style/Text.EV.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capacityLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/vehicle_hint_capacity"
                app:helperText="@string/vehicle_helper_capacity"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/capacityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/healthLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/vehicle_hint_health"
                app:helperText="@string/vehicle_helper_health"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/healthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/minPowerLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/vehicle_hint_min_power"
                app:helperText="@string/vehicle_helper_min_power"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/minPowerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/reserveLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/vehicle_hint_reserve"
                app:helperText="@string/vehicle_helper_reserve"
                app:helperTextTextAppearance="@style/Text.EV.Secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/reserveInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vehicleSaveAction"
                    style="@style/Widget.EVChargePilot.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_weight="1"
                    android:text="@string/routing_action_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vehicleResetAction"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/vehicle_action_reset" />
            </LinearLayout>

            <TextView
                android:id="@+id/vehicleAssumptions"
                android:layout_width="1400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="6dp"
                android:padding="@dimen/spacing_lg"
                android:text="@string/vehicle_assumptions"
                android:textAppearance="@style/Text.EV.Secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
