<?xml version="1.0" encoding="utf-8"?>
<!--
  CP-094: the car's map on the left three quarters, the companion on the last quarter —
  narrowed from a third on 2026-10-22 so the map, the thing being followed, gets the room.
  Glance-only while moving: charge and range, the destination against the range, the drive's
  eco score, the roads the plan offered, and one button that hands the map back.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/mapPane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3">

        <!-- Under the map: what shows while the car routes, before the pane is started. -->
        <TextView
            android:id="@+id/mapWaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/nav_split_map_waiting"
            android:textAppearance="@style/Text.EV.Secondary" />

    </FrameLayout>

    <!-- Every block is as tall as its content except the consumption card, which takes what is
         left; on a shorter panel the trace shrinks first. -->
    <!-- The car gives an app w1778dp h640dp, not 720: when the roads list makes the column
         taller than that, it scrolls instead of cutting the bottom off. fillViewport keeps the
         consumption card taking what is left whenever everything fits. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Charge in the ring, range beside it, the time, and the way back to the full map. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.evsuite.chargepilot.RingGaugeView
                android:id="@+id/splitSocRing"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:maxLines="1"
                    android:text="@string/label_range" />

                <TextView
                    android:id="@+id/splitRange"
                    style="@style/Text.EVChargePilot.Hero"
                    tools:text="355 km" />
            </LinearLayout>

            <!-- The time: the MG4 draws no status bar, so nothing else on the panel says it. -->
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/Text.EV.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitFullMap"
                style="@style/Widget.EVChargePilot.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@string/nav_split_full_map"
                android:tooltipText="@string/nav_split_full_map"
                app:icon="@drawable/ic_action_fullscreen" />
        </LinearLayout>

        <!-- The destination against the range: the bar is the trip, the track the reach. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/splitRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAppearance="@style/Text.EV.Title"
                tools:text="42 km · 37 min · arrival 8:21 PM" />

            <TextView
                android:id="@+id/splitRoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.EV.Secondary"
                tools:text="A64" />

            <com.evsuite.chargepilot.BarGaugeView
                android:id="@+id/splitReach"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/splitMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/Text.EV.Secondary"
                android:visibility="gone"
                tools:text="≈ 354 km of range left on arrival" />
        </LinearLayout>

        <!-- After Tesla's energy arc: filled to the average of the last kilometres, a tick at the
             reference, the figure inside, the trace beside it. Takes the height that is left. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/nav_split_consumption" />

                <TextView
                    android:id="@+id/splitConsumptionSpan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>

            <!-- A small arc holding the figure, the trace beside it on the rest of the card: the
                 2026-10-22 drive had the arc fill the card and the trace a thumbnail inside it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="96dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="128dp">

                    <com.evsuite.chargepilot.ArcGaugeView
                        android:id="@+id/splitArc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="36dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/splitConsumption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="@string/value_unavailable"
                            android:textAppearance="@style/Text.EV.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trace_axis_consumption"
                            android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>
                </FrameLayout>

                <com.evsuite.chargepilot.ConsumptionTraceView
                    android:id="@+id/splitTrace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- This drive's eco score, out of 100, with the part to work on. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.evsuite.chargepilot.RingGaugeView
                android:id="@+id/splitEcoRing"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/nav_split_eco" />

                <TextView
                    android:id="@+id/splitEcoBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Body"
                    tools:text="Économe" />

                <TextView
                    android:id="@+id/splitEcoParts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Secondary"
                    tools:text="anticipation 80 · souplesse 70 · efficacité 60" />
            </LinearLayout>
        </LinearLayout>

        <!-- The roads the plan offered, one line and one bar each, length is time. -->
        <LinearLayout
            android:id="@+id/splitRoads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.EV.ReadoutLabel"
                android:text="@string/nav_split_roads" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
