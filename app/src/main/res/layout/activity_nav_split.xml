<?xml version="1.0" encoding="utf-8"?>
<!--
  CP-094: the car's map on the left three quarters, the companion on the last quarter —
  narrowed from a third on 2026-10-22 so the map, the thing being followed, gets the room.
  Glance-only while moving: charge and range, consumption and the drive's eco score, then the
  destination against the range and the roads the plan offered, and one button that hands the
  map back.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/mapPane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3">

        <!-- Under the map: what shows while the car routes, before the pane is started. -->
        <TextView
            android:id="@+id/mapWaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/nav_split_map_waiting"
            android:textAppearance="@style/Text.EV.Secondary" />

    </FrameLayout>

    <!-- Every block is as tall as its content; what the column has left goes between them. -->
    <!-- The car gives an app w1778dp h640dp, not 720: when the roads list makes the column
         taller than that, it scrolls instead of cutting the bottom off. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Charge in the ring; the time over the range beside it; the way back to the full map.
             The column is 444dp wide on the car (bundle of 2026-11-02), so the ring and the
             clock take its height rather than sitting in a 72dp row with room to spare. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.evsuite.chargepilot.RingGaugeView
                android:id="@+id/splitSocRing"
                android:layout_width="@dimen/chargepilot_split_ring"
                android:layout_height="@dimen/chargepilot_split_ring" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/chargepilot_split_ring"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- The time: the MG4 draws no status bar, so nothing else on the panel says it.
                     Two thirds of the column: the driver asked for it larger (2026-11-02). It
                     shrinks to its share, so a 12-hour clock at 130 % fits the same box. -->
                <TextClock
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:autoSizeMaxTextSize="@dimen/chargepilot_text_hero"
                    android:autoSizeMinTextSize="@dimen/chargepilot_text_split_range_floor"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Display" />

                <!-- No label: kilometres beside the battery ring can only be the range. -->
                <TextView
                    android:id="@+id/splitRange"
                    style="@style/Text.EVChargePilot.Hero"
                    app:autoSizeMinTextSize="@dimen/chargepilot_text_split_range_floor"
                    tools:text="355 km" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitFullMap"
                style="@style/Widget.EVChargePilot.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@string/nav_split_full_map"
                android:tooltipText="@string/nav_split_full_map"
                app:icon="@drawable/ic_action_fullscreen" />
        </LinearLayout>

        <!-- The two gauges side by side, the figure inside each and one short line under it:
             the room goes to the figures, not to their labels (2026-11-25). The route sits with
             the other roads below, the gauges with the battery above. The row takes all the
             height the other blocks leave, so the gauges grow into it; the floor keeps them when
             the roads push the column into scrolling. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/chargepilot_split_gauge_floor"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- After Tesla's energy arc: filled to the average of the last kilometres, a tick at
                 the reference, the figure inside. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/splitArcFrame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.evsuite.chargepilot.ArcGaugeView
                        android:id="@+id/splitArc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <!-- Sized to the arc, so the figure grows and shrinks with it. -->
                    <TextView
                        android:id="@+id/splitConsumption"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="@dimen/chargepilot_text_hero"
                        android:autoSizeMinTextSize="@dimen/chargepilot_text_split_range_floor"
                        android:autoSizeTextType="uniform"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:padding="@dimen/chargepilot_split_arc_inset"
                        android:text="@string/value_unavailable"
                        android:textAppearance="@style/Text.EV.Display" />
                </FrameLayout>

                <TextView
                    android:id="@+id/splitConsumptionSpan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/Text.EV.Secondary"
                    tools:text="kWh/100 km · 15 km" />
            </LinearLayout>

            <!-- This drive's eco score, out of 100, coloured by how good it is. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.evsuite.chargepilot.RingGaugeView
                    android:id="@+id/splitEcoRing"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/splitEcoBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textAppearance="@style/Text.EV.Secondary"
                    tools:text="Économe" />
            </LinearLayout>
        </LinearLayout>

        <!-- The destination against the range: the bar is the trip, the track the reach. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/splitRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAppearance="@style/Text.EV.Display"
                tools:text="42 km · 37 min · arrival 8:21 PM" />

            <TextView
                android:id="@+id/splitRoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/Text.EV.Secondary"
                tools:text="A64" />

            <!-- Only with no guidance: there is no arrival to show, so the block offers one. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/splitDestination"
                style="@style/Widget.EVChargePilot.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charge_stop_action_destination"
                android:visibility="gone" />

            <com.evsuite.chargepilot.BarGaugeView
                android:id="@+id/splitReach"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/splitMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/Text.EV.Body"
                android:visibility="gone"
                tools:text="≈ 354 km · 72 % on arrival" />
        </LinearLayout>

        <!-- The other roads the plan offered, one line and one bar each, length is time. The
             driven one is the destination block above. -->
        <LinearLayout
            android:id="@+id/splitRoads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.EV.ReadoutLabel"
                android:text="@string/nav_split_roads" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
