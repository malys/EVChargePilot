<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: the pack's health is a trend this app measured, never a reading the car published.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, flat bars, no shadow.
  STORY: the estimate and what it rests on; the last charge; the gauge's calibration; what the
         pack has been through. Four cards, each answering one question.
  FIRST VIEWPORT: estimate top-left, exposure owning the right; history behind the bar actions.
  FORM: the two histories were full-width buttons stacked mid-pane and the apply action floated
        at the bottom, away from the figure it applies. The histories are page actions now, in
        the bar where Trips and Settings keep theirs; the apply action sits under its figure.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chargepilot_bar_height"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <include
            layout="@layout/view_primary_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chargeHistoryAction"
            style="@style/Widget.EVChargePilot.Button.OutlinedIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:contentDescription="@string/charge_history_open"
            android:minWidth="200dp"
            android:text="@string/battery_action_charges"
            app:icon="@drawable/ic_action_charges" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adviceHistoryAction"
            style="@style/Widget.EVChargePilot.Button.OutlinedIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@string/advice_history_open"
            android:minWidth="200dp"
            android:text="@string/battery_action_advice"
            app:icon="@drawable/ic_action_advice" />
    </LinearLayout>

    <!-- Scrolls only when the cards outgrow the car's w1778dp h640dp box; otherwise
         fillViewport keeps the weighted cards filling the page as before. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/chargepilot_bar_gap"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- The estimate, its band on a 0–100 % track, the mark at the figure the driver
                 declared, and — right under it — the action that copies it into the settings. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_health_state_of_health" />

                <!-- CP-085. The hero style sized into a fixed box: the value always carries its
                     band, and "≈ 97,2 % ± 1,6 %" shrinks to fit rather than wrap. -->
                <TextView
                    android:id="@+id/healthValue"
                    style="@style/Text.EVChargePilot.Hero"
                    android:layout_height="88dp"
                    android:layout_weight="0"
                    android:text="@string/value_unavailable" />

                <com.evsuite.chargepilot.BarGaugeView
                    android:id="@+id/healthBar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/healthTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Body" />

                <TextView
                    android:id="@+id/healthEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/Text.EV.Secondary" />

                <TextView
                    android:id="@+id/applyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/applyAction"
                    style="@style/Widget.EV.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxWidth="880dp"
                    android:text="@string/battery_health_apply"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The charge side of the ledger: the one in progress, then the last one. The health
                 estimate reads discharges only, so this is the half it never sees. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_last_charge_title" />

                <!-- CP-089. The charge in progress and when it ends; gone when none is. -->
                <TextView
                    android:id="@+id/chargeLive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Body"
                    android:visibility="gone" />

                <!-- Where on the gauge the last charge ran, as figures and as a span of 0–100 %. -->
                <TextView
                    android:id="@+id/chargeRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Display"
                    android:visibility="gone" />

                <com.evsuite.chargepilot.BarGaugeView
                    android:id="@+id/chargeBar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chargeFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_health_calibration" />

                <!-- CP-085. A state glyph and a word, coloured, with the words carrying the meaning. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/calibrationIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/Text.EV.Display" />

                    <TextView
                        android:id="@+id/calibrationState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textAppearance="@style/Text.EV.Title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/calibrationVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/Text.EV.Body" />

                <TextView
                    android:id="@+id/calibrationFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_health_exposure" />

                <!-- Three figures first, the split bar under them, the details last. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/cyclesValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:id="@+id/cyclesLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/kmPerCycleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/battery_health_exposure_km_label" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/meanSocValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/battery_health_exposure_mean_label" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CP-085. Recorded time split below, between and above the two thresholds. -->
                <com.evsuite.chargepilot.BarGaugeView
                    android:id="@+id/exposureBar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/exposureLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Secondary" />

                <TextView
                    android:id="@+id/exposureFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
