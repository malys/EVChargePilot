<?xml version="1.0" encoding="utf-8"?>
<!--
  Impeccable direction contract
  THESIS: the pack's health is a trend this app measured, never a reading the car published.
  OWN-WORLD: EVSuite tonal panes, one outline, one radius, Roboto readouts, flat bars, no shadow.
  STORY: read the trend, then what it was measured from, then what the pack has been through.
  FIRST VIEWPORT: the estimate anchors the left pane; calibration and exposure own the right.
  FORM: two-pane evidence ledger extending the trip history; seed key cp070-20260916.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chargepilot_bar_height"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <include
            layout="@layout/view_primary_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/chargepilot_bar_gap"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            style="@style/Widget.EV.Readout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="@style/Text.EV.ReadoutLabel"
                android:text="@string/battery_health_state_of_health" />

            <!-- CP-085. The hero style sized into a fixed box: the value always carries its band,
                 and "≈ 97,2 % ± 1,6 %" shrinks to fit half the panel rather than wrap. -->
            <TextView
                android:id="@+id/healthValue"
                style="@style/Text.EVChargePilot.Hero"
                android:layout_height="96dp"
                android:layout_weight="0"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/value_unavailable" />

            <!-- CP-085. The estimate on a 0–100 % track, its ± band lighter, and the mark at the
                 figure the driver declared: the line under the evidence names the mark. -->
            <com.evsuite.chargepilot.BarGaugeView
                android:id="@+id/healthBar"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/healthTrend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/Text.EV.Body" />

            <TextView
                android:id="@+id/healthEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/Text.EV.Secondary" />

            <!-- The charge side of the same ledger. It lives under the estimate rather than in
                 the exposure pane because this pane is the one with room by construction: the
                 space below the evidence exists only to push the apply button down. -->
            <TextView
                android:id="@+id/chargeFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="@style/Text.EV.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chargeHistoryAction"
                style="@style/Widget.EV.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/charge_history_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adviceHistoryAction"
                style="@style/Widget.EV.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/advice_history_open" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/applyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:textAppearance="@style/Text.EV.Secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/applyAction"
                style="@style/Widget.EV.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:text="@string/battery_health_apply"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.EV.Readout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_health_calibration" />

                <!-- CP-085. A state glyph and a word, coloured, with the words carrying the meaning. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/calibrationIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/Text.EV.Display" />

                    <TextView
                        android:id="@+id/calibrationState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textAppearance="@style/Text.EV.Title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/calibrationVerdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/Text.EV.Body" />

                <TextView
                    android:id="@+id/calibrationFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.EV.Readout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    style="@style/Text.EV.ReadoutLabel"
                    android:text="@string/battery_health_exposure" />

                <!-- CP-085. Recorded time split below, between and above the two thresholds. -->
                <com.evsuite.chargepilot.BarGaugeView
                    android:id="@+id/exposureBar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/exposureLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.EV.Secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/cyclesValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:id="@+id/cyclesLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/kmPerCycleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/battery_health_exposure_km_label" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/meanSocValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:text="@string/value_unavailable" android:textAppearance="@style/Text.EV.Display" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/battery_health_exposure_mean_label" android:textAppearance="@style/Text.EV.Secondary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/exposureFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/Text.EV.Secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
